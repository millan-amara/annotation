# Copy to .env.local (gitignored) for local development, and set the same
# values in Vercel -> Project -> Settings -> Environment Variables.

# Supabase -> Project Settings -> API. The anon / publishable key is meant to
# be public; access is controlled by the policies in supabase/schema.sql.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Turns the contributor portal (/user/*) on in production builds.
VITE_ENABLE_PORTAL=true
